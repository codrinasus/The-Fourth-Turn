# Copy this file to .env and edit it:   cp .env.example .env
# The app reads .env at startup (app/config.py). docker-compose overrides the *_URL
# values for in-container networking, so you rarely touch those for Docker.

# ============================================================================
# CHAT PROVIDER — the model that writes the answers
# Pick ONE provider and set LLM_PROVIDER + CHAT_MODEL to match.
# This is an OPEN-SOURCE challenge: any model you can host on your own machine is fair.
# ============================================================================

LLM_PROVIDER=ollama
CHAT_MODEL=qwen3:8b

# --- Option A (default): LM Studio -----------------------------------------
# LM Studio runs a local OpenAI-compatible server. To use it:
#   1. install LM Studio, download a model (e.g. Gemma), load it,
#   2. open the "Developer" / "Local Server" tab and Start Server (default port 1234).
# CHAT_MODEL must match the model id LM Studio shows.
#   LLM_PROVIDER=lmstudio
#   CHAT_MODEL=google/gemma-4-e2b
LMSTUDIO_BASE_URL=http://localhost:1234

# --- Option B: Ollama -------------------------------------------------------
# Install Ollama, then:  ollama pull qwen3:8b
# Set LLM_PROVIDER=ollama and CHAT_MODEL to the pulled tag.
#   LLM_PROVIDER=ollama
#   CHAT_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Option C: litellm (hosted APIs — OpenAI, Anthropic, Gemini, Groq, ...) --
# Only if you want a hosted model instead of a local one.
#   LLM_PROVIDER=litellm
#   CHAT_MODEL=gpt-4o-mini
#   LITELLM_API_KEY=sk-...
LITELLM_API_BASE=
LITELLM_API_KEY=

# ============================================================================
# EMBEDDINGS — turning text into vectors (this is yours to improve)
# ============================================================================
# Default for this team: local Ollama embeddings, so the FastAPI image stays light.
# Pull once: docker compose -f docker-compose.yml -f docker-compose.ollama.yml -f docker-compose.docling.yml exec ollama ollama pull nomic-embed-text
EMBEDDING_BACKEND=provider
EMBEDDING_MODEL=nomic-embed-text

# ============================================================================
# PDF PARSING - Docling is the default parser
# ============================================================================
# Docling runs as a local HTTP service with docker-compose.docling.yml.
# /ingest sends the PDF to Docling, caches JSON/Markdown, then indexes it.
PDF_PARSER=docling
DOCLING_BASE_URL=http://localhost:5001
DOCLING_OUTPUT_DIR=data/extracted/docling
DOCLING_TIMEOUT=600
DOCLING_TABLE_MODE=accurate
DOCLING_IMAGE_EXPORT_MODE=referenced
DOCLING_DO_OCR=false
DOCLING_USE_CACHE=true

# ============================================================================
# QDRANT (vector store) — unusual host port to avoid clashes
# ============================================================================
QDRANT_URL=http://localhost:6391
QDRANT_COLLECTION=aim_hackathon

# ============================================================================
# RETRIEVAL
# ============================================================================
TOP_K=5
# Used by app/rag/chunking.py:
CHUNK_SIZE=800
CHUNK_OVERLAP=0

# ============================================================================
# DATA FOLDERS
# ============================================================================
IN_DIR=data/in        # put your PDF here; /ingest reads it
OUT_DIR=data/out      # every /query answer is written here

REQUEST_TIMEOUT=120
