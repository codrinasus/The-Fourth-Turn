{
  "info": {
    "name": "AIMultimediaLab @ ESSIR 2026 — The Fourth Turn",
    "description": "RAG-over-PDF backend — health, ingest and query. Import into Postman (or Bruno / Insomnia / Hoppscotch). {{base_url}} defaults to the app's port (8791). Put your PDF in data/in, then run in order: Ingest, then the Query requests. Each /query response is also written to data/out and is exactly what you copy into submission/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8791"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Ready (checks Qdrant)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/ready"
      }
    },
    {
      "name": "List collections",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/collections"
      }
    },
    {
      "name": "Ingest the PDF (from data/in)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": null,\n  \"reset\": false\n}"
        },
        "description": "Index the first *.pdf in data/in/. Pass \"reset\": true to rebuild, or \"filename\" to pick a specific PDF."
      }
    },
    {
      "name": "Query — Level 1 (retrieval)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"<a standalone question about your document>\",\n  \"level\": 1\n}"
        },
        "description": "Just a question and its level. The system assigns the id and conversation for you. The response is written to data/out."
      }
    },
    {
      "name": "Query — Level 2 (memory / follow-up)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"<a follow-up that depends on an earlier level-2 question>\",\n  \"level\": 2\n}"
        },
        "description": "Send your level-2 questions in order. They automatically share one conversation, so your system can use the earlier turns."
      }
    },
    {
      "name": "Query — Level 3 (whole-document)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"<a question that needs evidence from across the whole document>\",\n  \"level\": 3\n}"
        }
      }
    },
    {
      "name": "Chosen questions",
      "description": "Concrete q1-q9 requests copied from submission/. Send Level 2 requests in order: q4, then q5, then q6.",
      "item": [
        {
          "name": "q1 - Level 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many papers does the survey consider, and how many of them receive a more detailed treatment?\",\n  \"level\": 1\n}"
            }
          }
        },
        {
          "name": "q2 - Level 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the main goal of explainable information retrieval according to the survey?\",\n  \"level\": 1\n}"
            }
          }
        },
        {
          "name": "q3 - Level 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How does the survey categorise the evaluation of explanations?\",\n  \"level\": 1\n}"
            }
          }
        },
        {
          "name": "q4 - Level 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the main limitation the authors acknowledge?\",\n  \"level\": 2\n}"
            }
          }
        },
        {
          "name": "q5 - Level 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Why does that happen?\",\n  \"level\": 2\n}"
            }
          }
        },
        {
          "name": "q6 - Level 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"And how do they propose to address it?\",\n  \"level\": 2\n}"
            }
          }
        },
        {
          "name": "q7 - Level 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Across the classification tables in this survey - post-hoc methods, axiomatic methods, explainable-by-architecture models and rationale-based approaches - what is the most common way the quality of explanations is evaluated, and what do the authors themselves say about relying on that kind of evidence?\",\n  \"level\": 3\n}"
            }
          }
        },
        {
          "name": "q8 - Level 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Summarise the contribution of each section.\",\n  \"level\": 3\n}"
            }
          }
        },
        {
          "name": "q9 - Level 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"The introduction warns that over-parameterized models learn \\\"shortcuts\\\". Tracing this concept through the attention-based feature attribution work (Section 3.2.2) and the probing of ranking models (Section 7.2), what specific token-level behavior exemplifies this, and what vulnerability does it create?\",\n  \"level\": 3\n}"
            }
          }
        }
      ]
    }
  ]
}